# Copia a `.env` para desarrollo local. `.env` está en .gitignore.
#
# Los cuatro modos de abajo deciden qué adaptador entra. Con todo en falso/memoria el
# backend arranca sin una sola credencial de GCP — que es como se trabaja en local y
# como corre la suite de tests. `cargarEnv` se niega a arrancar con NODE_ENV=production
# si alguno sigue en modo de desarrollo.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- Adaptadores -------------------------------------------------------------
# fake       → `Authorization: Bearer dev:<uid>` autentica como ese uid
# firebase   → verifica ID tokens reales con el Admin SDK
AUTH_MODE=fake

# memoria    → datos en RAM, se pierden al reiniciar
# firestore  → Firestore real (respeta FIRESTORE_EMULATOR_HOST si está puesto)
DB_MODE=memoria

# memoria    → los bytes quedan en RAM
# gcs        → Cloud Storage
STORAGE_MODE=memoria

# fake           → el token decide el veredicto (`fake:no_confiable`, `fake:no_evaluado`)
# playintegrity  → consulta real a la Play Integrity API
INTEGRITY_MODE=fake

# --- GCP (sólo con adaptadores reales) ---------------------------------------
# GCP_PROJECT_ID=verificlean-prod
# STORAGE_BUCKET=verificlean-evidencias
# GOOGLE_APPLICATION_CREDENTIALS=./credenciales.json

# --- Emulador de Firestore ---------------------------------------------------
# Con esto puesto, DB_MODE=firestore apunta al emulador y no a la nube.
# FIRESTORE_EMULATOR_HOST=localhost:8081

# --- Ajustes -----------------------------------------------------------------
ANDROID_PACKAGE_NAME=com.verificlean.app
MAX_FOTO_BYTES=8388608
URL_FIRMADA_MINUTOS=15

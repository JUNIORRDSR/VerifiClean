<?xml version="1.0" encoding="utf-8"?>
<!--
  No se respalda nada. La base local guarda evidencias todavía sin sincronizar, y sus
  archivos están cifrados con claves del Android Keystore que no salen del dispositivo:
  restaurar el respaldo en otro teléfono dejaría archivos imposibles de descifrar y una
  cola de sincronización apuntando a datos inexistentes.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
